# Salin menjadi docker.env lalu isi. docker.env TIDAK boleh di-commit.

# --- Aplikasi ---
# production: wajib HTTPS (lewat tunnel). Untuk uji di komputer sendiri pakai local.
APP_ENV=production
APP_DEBUG=false
# Alamat publik, mis. https://banksampah.tunnel.my.id (uji lokal: http://localhost:8080)
APP_URL=https://GANTI.tunnel.my.id
TIMEZONE=Asia/Jakarta
SESSION_LIFETIME=3600

# Kunci tanda tangan token API, minimal 32 karakter acak.
# Buat dengan: openssl rand -hex 32
API_SECRET=

# --- Koneksi aplikasi ke database ---
DB_HOST=db
DB_PORT=3306
DB_NAME=bank_sampah_desa
DB_USER=banksampah
DB_PASSWORD=GANTI_SANDI_DB

# --- Container MariaDB (harus sama dengan DB_* di atas) ---
MARIADB_DATABASE=bank_sampah_desa
MARIADB_USER=banksampah
MARIADB_PASSWORD=GANTI_SANDI_DB
MARIADB_ROOT_PASSWORD=GANTI_SANDI_ROOT

# 1 = akun data awal (password123) wajib ganti sandi saat login pertama
WAJIB_GANTI_SANDI_AWAL=1
