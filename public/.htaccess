# Folder ini boleh diakses dari web (folder induk ditutup)
Require all granted

# Aktifkan rewrite engine
RewriteEngine On

# Tanpa RewriteBase: Apache memakai lokasi folder ini sendiri, sehingga
# berjalan di /banksampah/public/ (XAMPP) maupun di / (Docker).

# Jika file fisik ada, langsung serve
RewriteCond %{REQUEST_FILENAME} !-f

# Jika folder fisik ada, langsung serve
RewriteCond %{REQUEST_FILENAME} !-d

# Rewrite semua request ke index.php
RewriteRule ^(.*)$ index.php [QSA,L]
